# Optional for B01. JSON array of explicit browser origins; empty disables CORS.
ALLOWED_ORIGINS=["http://localhost:5173"]

# Optional: omit URI to run foundation-only health/regions without persistence.
# Set the real URI only in backend/.env, never in source or chat.
# MONGODB_URI=mongodb+srv://<app-user>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=climate_hazard_analyzer
MONGODB_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=10

# Fixed Open-Meteo host/model; sequential full-year requests, no arbitrary URLs.
WEATHER_CALL_TIMEOUT_SECONDS=20
WEATHER_OPERATION_TIMEOUT_SECONDS=240
WEATHER_MAX_RETRIES=2
WEATHER_REQUEST_INTERVAL_SECONDS=3
WEATHER_MAX_YEARS=40

# B07 single-process work/cache/output bounds (per-IP limiting is B08).
ANALYSIS_MAX_CACHE_ENTRIES=100
ANALYSIS_MAX_EVENTS=5000
ANALYSIS_MAX_RESPONSE_BYTES=4000000
ANALYSIS_MAX_PENDING=8

# B08: single-process limits; exact trusted proxy IPs/CIDRs, never wildcard trust.
RATE_REQUESTS=60
RATE_WINDOW_SECONDS=60
COLD_REQUESTS=2
COLD_WINDOW_SECONDS=600
RATE_MAX_CLIENTS=2048
REQUEST_MAX_BODY_BYTES=4096
REQUEST_MAX_CONCURRENT=16
TRUSTED_PROXY_NETWORKS=[]
# Conservative weighted units: each full-year HTTP attempt costs 40.
PROVIDER_CALLS_PER_MINUTE=480
PROVIDER_CALLS_PER_HOUR=4500
PROVIDER_CALLS_PER_DAY=9000
